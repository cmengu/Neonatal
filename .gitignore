# Matplotlib font cache (from MPLCONFIGDIR)
.mpl_config/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/

# Secrets — .env holds real API keys and must never be committed.
# NOTE: `env/` above matches a *directory*; it does NOT match the file `.env`.
.env
.env.*
!.env.example

# Jupyter
.ipynb_checkpoints/

# Data/output (adjust if you commit processed data)
*.log
logs/

# Eval results (generated outputs — not committed)
results/

# Qdrant on-disk runtime lock (do not commit)
qdrant_local/.lock

# Claude Code local commands (not committed)
.claude/

# JEPA sweep intermediate checkpoints (winner promoted to models/jepa/jepa.pt)
models/jepa/sweep/*.pt

# Playwright raw capture scratch (final video lives at docs/demo/showtime-demo.*)
docs/demo/.raw/

# Staged feature regeneration output (scripts/regenerate_hrv_features.py).
# Large derived CSVs — regenerate rather than commit. Promote deliberately with
# --promote once the downstream JEPA retrain (#75) is ready to follow.
data/processed/staging/
